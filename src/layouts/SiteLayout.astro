---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const navigation = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Writing', href: '/writing' },
  { label: 'Projects', href: '/projects' },
  { label: 'Tools', href: '/tools' },
  { label: 'Fun', href: '/fun' },
  { label: 'Contact', href: '/contact' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="description" content={description} />
    <title>{title} · Sufal Kumar Chhabra</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Sufal Kumar Chhabra, home">SKC<span>.</span></a>
        <nav aria-label="Main navigation">
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class:list={{ active: currentPath === item.href }}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #20231f;
    background: #f7f6f2;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
  }

  a {
    color: inherit;
  }

  .site-shell {
    width: min(100% - 3rem, 1040px);
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 88px;
    border-bottom: 1px solid #e3e1d9;
  }

  .wordmark {
    flex: 0 0 auto;
    color: #20231f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.08em;
    text-decoration: none;
  }

  .wordmark span {
    color: #7b8e66;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1.25rem;
  }

  nav a {
    padding: 0.5rem 0;
    color: #656960;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 140ms ease;
  }

  nav a:hover,
  nav a.active {
    color: #20231f;
  }

  nav a.active {
    text-decoration: underline;
    text-decoration-color: #9baa88;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  main {
    min-height: calc(100vh - 89px);
  }

  .page-content {
    display: flex;
    min-height: min(70vh, 680px);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 5rem 0 7rem;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: #71766c;
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.25rem, 8vw, 6.25rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .tagline {
    margin: 1.5rem 0 0;
    color: #62675f;
    font-size: clamp(1rem, 2.3vw, 1.2rem);
    letter-spacing: 0.015em;
    line-height: 1.7;
  }

  .page-description {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: #454a43;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    line-height: 1.65;
  }

  .divider {
    width: 3.5rem;
    height: 1px;
    margin-top: 2.25rem;
    background: #b8b9ad;
  }

  @media (max-width: 700px) {
    .site-shell {
      width: min(100% - 2rem, 1040px);
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
      padding: 1.25rem 0 1rem;
    }

    nav {
      justify-content: flex-start;
      gap: 0.15rem 1.1rem;
    }

    nav a {
      padding: 0.35rem 0;
      font-size: 0.88rem;
    }

    .page-content {
      min-height: 64vh;
      padding: 4rem 0 5rem;
    }
  }
</style>
