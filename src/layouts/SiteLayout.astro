---
import SiteNavigation from '../components/SiteNavigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../site.config';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = site.description,
  ogType = 'website',
  ogImage = site.defaultOgImage,
  ogImageAlt = `${site.name} — ${site.tagline}`,
  structuredData,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonicalUrl = new URL(Astro.url.pathname, `${site.url}/`).href;
const imageUrl = new URL(ogImage, `${site.url}/`).href;
const personId = `${site.url}/#person`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    description: site.description,
    publisher: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: site.name,
    url: site.url,
    jobTitle: site.tagline.split(' · '),
  },
];
if (structuredData) graph.push(structuredData);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
  .replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f2" />
    <meta name="description" content={description} />
    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={jsonLd} />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <div class="site-shell">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.shortName}<span>.</span></a>
        <SiteNavigation />
      </header>
      <main id="main-content"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>
