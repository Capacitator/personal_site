---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { site } from '../../site.config';

type Props = { entry: CollectionEntry<'writing'> };

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const allArticles = await getCollection('writing', ({ data }) => !data.draft);
const chronologicalArticles = allArticles
  .slice()
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = chronologicalArticles.findIndex((article) => article.id === entry.id);
const previousArticle = chronologicalArticles[currentIndex + 1];
const related = chronologicalArticles
  .filter((article) =>
    article.id !== entry.id && article.id !== previousArticle?.id && article.data.category === entry.data.category,
  )
  .slice(0, 3);

const formatDate = (date: Date) => new Intl.DateTimeFormat('en', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(date);
const articleUrl = new URL(Astro.url.pathname, `${site.url}/`).href;
const articleSchema = {
  '@type': 'Article',
  '@id': `${articleUrl}#article`,
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  articleSection: entry.data.category,
  keywords: entry.data.tags,
  mainEntityOfPage: articleUrl,
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
  image: entry.data.image ? [new URL(entry.data.image, `${site.url}/`).href] : undefined,
};
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  ogImage={entry.data.image}
  ogImageAlt={entry.data.imageAlt}
  structuredData={articleSchema}
>
  <div class="page-content article-page">
    <a class="back-link" href="/writing">← All writing</a>
    <article class="article-shell">
      <PageHeader title={entry.data.title} description={entry.data.description} />
      <p class="article-meta article-byline">
        <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{entry.data.category}</span>
        {entry.data.updatedDate && <>
          <span aria-hidden="true">·</span>
          <span>Updated <time datetime={entry.data.updatedDate.toISOString()}>{formatDate(entry.data.updatedDate)}</time></span>
        </>}
      </p>
      {entry.data.tags.length > 0 && (
        <ul class="article-tags" aria-label="Tags">
          {entry.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      <div class="article-content"><Content /></div>
      <nav class="article-navigation" aria-label="Article navigation">
        {previousArticle && (
          <a href={`/writing/${previousArticle.id}`}>← Previous: {previousArticle.data.title}</a>
        )}
        <a href="/writing">Back to all writing</a>
      </nav>
    </article>

    {related.length > 0 && (
      <section class="related-writing" aria-labelledby="related-heading">
        <h2 id="related-heading">Related writing</h2>
        <ul>
          {related.map((article) => (
            <li><a href={`/writing/${article.id}`}>{article.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</SiteLayout>
