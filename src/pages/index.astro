---
import SiteLayout from '../layouts/SiteLayout.astro';
import Section from '../components/Section.astro';
---

<SiteLayout
  title="Home"
  description="The personal website of Sufal Kumar Chhabra: researcher, developer, teacher, and writer."
>
  <section class="page-content">
    <p class="eyebrow">A personal website</p>
    <h1>Sufal Kumar Chhabra</h1>
    <p class="tagline">Researcher · Developer · Teacher · Writer</p>
    <span class="divider" aria-hidden="true"></span>
    <p class="page-description">Curious about ideas, how things work, and what we can make together.</p>
  </section>
  <Section title="Explore">
    <p>Writing, research, useful tools, and playful experiments will all have a home here.</p>
  </Section>
</SiteLayout>
